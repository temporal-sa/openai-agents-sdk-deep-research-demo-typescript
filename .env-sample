# Required. Keep the real key in .env or a secret manager; never commit it.
OPENAI_API_KEY=your-openai-api-key

# Local Temporal development server defaults.
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=research-queue
TEMPORAL_TLS=false
# TEMPORAL_API_KEY=

# Combined web server and worker.
PORT=8234
PROJECT_ROOT=.
ARTIFACT_ROOT=artifacts
FRONTEND_ORIGINS=http://localhost:8234

# Local development only. The other supported value is temporal-ingress.
# temporal-ingress trusts X-Temporal-Auth-Email from the managed ingress, so do
# not expose that mode without a trusted proxy that strips and injects headers.
AUTH_MODE=disabled
# AUTH_ALLOWED_DOMAIN=temporal.io

# Force clarifying questions so the human-in-the-loop retry path is visible.
# Remove this variable to let the triage agent decide whether they are needed.
BYPASS_TRIAGE_AGENT=Y
